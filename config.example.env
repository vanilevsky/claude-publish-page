# publish-page configuration — EXAMPLE.
#
# The real file is written by `python3 setup.py` to (and read from):
#   ${CLAUDE_CONFIG_DIR:-~/.claude}/skill-data/publish-page/config.env   (mode 600)
# Override that location with $PUBLISH_PAGE_CONFIG. Every key below can also be
# supplied as an environment variable, which takes precedence over the file.
#
# Do NOT commit a filled-in config — it contains your secret keys.

# --- Required ---

# Bucket name.
S3_BUCKET=my-pages

# Public URL prefix where the bucket is served. Final link = {S3_PUBLIC_BASE}/{key}
#   Cloudflare R2 : https://pub-<hash>.r2.dev
#   AWS S3        : https://<bucket>.s3.<region>.amazonaws.com  (or a CloudFront domain)
#   MinIO/other   : https://cdn.example.com
S3_PUBLIC_BASE=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# S3 API credentials (Object Read & Write is enough).
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# --- Optional ---

# S3 endpoint. Leave EMPTY for AWS S3 (boto3 uses the default AWS endpoint).
#   Cloudflare R2 : https://<account-id>.r2.cloudflarestorage.com
#   MinIO         : https://minio.example.com
#   Backblaze B2  : https://s3.<region>.backblazeb2.com
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Region. Cloudflare R2 uses "auto"; AWS needs a real region, e.g. us-east-1.
S3_REGION=auto
